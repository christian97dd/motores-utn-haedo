  title: FICHA DE SUJETO
  subtitle: "PROYECTO DE TRANSFORMACI\xD3N // ACCESO NIVEL 3"
  terminalLabel: "> ARCHIVO M\xC9DICO \xB7 LABORATORIO B-2"
  headline: "SUJETO N.\xBA {codigo}"
  stamp: CONFIDENCIAL
  photo: {fileID: 21300000, guid: 905f25ba659f4426b899ca0cdd5de494, type: 3}
