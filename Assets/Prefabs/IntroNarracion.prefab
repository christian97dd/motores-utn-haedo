--- !u!114 &1667238558165074871
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8371429492333038535}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23ec5dc7767e2450daa45a813b633377, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroNarration
  voice: {fileID: 8594288098164131710}
  screen: {fileID: 4350942455982247505}
  panelImage: {fileID: 8613499991821858447}
  subtitleLabel: {fileID: 2623680765450388513}
  panelFadeTime: 0.8
  endFadeTime: 1.5
  subtitles:
  - start: 0
    end: 6.5
    text: "Qu\xE9 lindo salir a dar una vuelta..."
  - start: 7
    end: 10.5
    text: "Ya estoy cansado. El estr\xE9s, el laburo..."
  - start: 11
    end: 21.5
    text: Pero bueno, ya... por suerte estoy bastante tranquilo.
  - start: 22
    end: 24.8
    text: Es raro... esa camioneta no la veo.
  - start: 25
    end: 28.8
    text: "\xBFQu\xE9? \xA1No, par\xE1!"
  - start: 29
    end: 37.5
    text: "Eh... \xBFd\xF3nde...?"
  - start: 38
    end: 41.8
    text: Ah... me duele la cabeza.
  - start: 42
    end: 43.8
    text: "\xBFHola?"
  - start: 44
    end: 46.8
    text: "\xBFD\xF3nde estoy?"
  - start: 47
    end: 51.3
    text: "\xBFQu\xE9 es esto?"
  panels: []
  skipAction:
    m_Name: Saltear
    m_Type: 1
    m_ExpectedControlType: 
    m_Id: 56b563a4-08dd-4310-bda3-4781cabf479c
    m_Processors: 
    m_Interactions: 
    m_SingletonActionBindings:
    - m_Name: 
      m_Id: 5ee65c7b-e1ca-4ffc-945b-3e9e03155e61
      m_Path: <Keyboard>/space
      m_Interactions: 
      m_Processors: 
      m_Groups: 
      m_Action: Saltear
      m_Flags: 0
    m_Flags: 0
